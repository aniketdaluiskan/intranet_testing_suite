{
  "name": "intranet-testing-suite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hostable fake-intranet QA fixture: a portal of look-alike sub-apps with ever-changing labels, controls, synthetic values and URLs. Test data only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
